{
  "name": "Mac File Gateway",
  "bundle_release": "2.4.0",
  "runtime_version": "2.4.0",
  "built_on": "2026-10-06",
  "source_baseline": "release/ms1",
  "mcp_tools_always": [
    "gateway_info",
    "list_files",
    "read_file",
    "search_files"
  ],
  "mcp_tools_when_writes_enabled": [
    "create_directory",
    "create_file",
    "write_file",
    "replace_text",
    "delete_file",
    "remove_file",
    "unlink",
    "rename",
    "move"
  ],
  "mcp_tools_when_exec_enabled": [
    "run_command"
  ],
  "controlled_execution": {
    "shell": false,
    "requires_allow_exec": true,
    "requires_exec_path": true,
    "runner_fallback": "nearest Pipfile inside exec scope => pipenv; otherwise direct",
    "allowed_commands": [
      "pytest",
      "python -m pytest",
      "python -m compileall",
      "python <relative-script.py>",
      "go test",
      "go vet"
    ]
  },
  "directory_delete": false,
  "arbitrary_shell": false,
  "mcp_tools_when_local_skill_bridge_configured": [
    "local_skill_info",
    "begin_local_skill",
    "read_skill_file",
    "run_skill_script"
  ],
  "local_skill_bridge": {
    "configured_by": "--local-skill-root",
    "requires_allow_exec": false,
    "policy_dir_default": "~/.config/mac-file-gateway/local-skill-policy",
    "sample_policy_loaded_by_default": false
  }
}
