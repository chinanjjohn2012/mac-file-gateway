{
  "name": "Mac File Gateway",
  "bundle_release": "2.4.0",
  "runtime_version": "2.4.0",
  "built_on": "2026-10-06",
  "source_baseline": "release/ms1",
  "mcp_tools_always": [
    "gateway_info",
    "list_files",
    "read_file",
    "search_files"
  ],
  "mcp_tools_when_writes_enabled": [
    "create_directory",
    "delete_directory",
    "create_file",
    "write_file",
    "replace_text",
    "delete_file",
    "remove_file",
    "unlink",
    "rename",
    "move"
  ],
  "mcp_tools_when_exec_enabled": [
    "run_command"
  ],
  "controlled_execution": {
    "shell": false,
    "requires_allow_exec": true,
    "requires_exec_path": true,
    "runner_fallback": "nearest Pipfile inside exec scope => pipenv; otherwise direct",
    "allowed_commands": [
      "pytest",
      "python -m pytest",
      "python -m compileall",
      "python <relative-script.py>",
      "go test",
      "go vet"
    ]
  },
  "directory_delete": "empty_only",
  "arbitrary_shell": false,
  "mcp_tools_when_local_skill_bridge_configured": [
    "local_skill_info",
    "begin_local_skill",
    "read_skill_file",
    "run_skill_script"
  ],
  "local_skill_bridge": {
    "configured_by": "--local-skill-root",
    "requires_allow_exec": false,
    "policy_dir_default": "~/.config/mac-file-gateway/local-skill-policy",
    "sample_policy_loaded_by_default": false
  },
  "hidden_directories": "exact_allowlist_via_--allow-hidden-path",
  "mcp_tools_when_git_authorized": [
    "run_git"
  ],
  "git_cli_v1": {
    "release_status": "candidate_not_published_in_release_ms1",
    "authorization": "Legacy --allow-git plus repeatable --git-command; Multi requires server.git.enabled plus per-workspace git.allowed_commands",
    "supported_commands": [
      "status",
      "diff",
      "log",
      "branch",
      "switch",
      "add",
      "commit",
      "fetch",
      "pull",
      "push"
    ],
    "mcp_protocols": [
      "2025-11-25",
      "2026-07-28"
    ],
    "rest_endpoint": "POST /git/run",
    "default_preview": true,
    "timeout_seconds": {
      "default": 120,
      "min": 10,
      "max": 900
    },
    "max_git_request_bytes": 65536,
    "legacy_stdio": true,
    "multi_stdio": false,
    "read_only_does_not_disable_git": true,
    "offline_only_quarantine_recovery": true,
    "git_is_not_a_sandbox": true
  }
}
